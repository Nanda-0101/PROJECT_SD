{
  "task": "tabular-classification",
  "model_type": "Ensemble: 0.5 * P(LightGBM) + 0.5 * P(MLP)",
  "class_names": {
    "0": "Underweight",
    "1": "Normal",
    "2": "Overweight",
    "3": "Obesity"
  },
  "feature_order": [
    "Sex",
    "Age",
    "Height",
    "Overweight_Obese_Family",
    "Consumption_of_Fast_Food",
    "Frequency_of_Consuming_Vegetables",
    "Number_of_Main_Meals_Daily",
    "Food_Intake_Between_Meals",
    "Smoking",
    "Liquid_Intake_Daily",
    "Calculation_of_Calorie_Intake",
    "Physical_Exercise",
    "Schedule_Dedicated_to_Technology",
    "Type_of_Transportation_Used"
  ],
  "feature_schema": {
    "Sex": {
      "label": "Jenis kelamin",
      "options": {
        "1": "Laki-laki",
        "2": "Perempuan"
      }
    },
    "Age": {
      "label": "Usia (tahun)",
      "min": 18,
      "max": 80,
      "default": 30,
      "train_range": [
        18,
        54
      ]
    },
    "Height": {
      "label": "Tinggi badan (cm)",
      "min": 120,
      "max": 220,
      "default": 168,
      "train_range": [
        150,
        193
      ]
    },
    "Overweight_Obese_Family": {
      "label": "Ada anggota keluarga overweight/obesitas?",
      "options": {
        "1": "Ya",
        "2": "Tidak"
      }
    },
    "Consumption_of_Fast_Food": {
      "label": "Mengonsumsi fast food?",
      "options": {
        "1": "Ya",
        "2": "Tidak"
      }
    },
    "Frequency_of_Consuming_Vegetables": {
      "label": "Frekuensi makan sayur",
      "options": {
        "1": "Jarang",
        "2": "Kadang-kadang",
        "3": "Selalu"
      }
    },
    "Number_of_Main_Meals_Daily": {
      "label": "Jumlah makan utama per hari",
      "options": {
        "1": "1-2 kali",
        "2": "3 kali",
        "3": "Lebih dari 3 kali"
      }
    },
    "Food_Intake_Between_Meals": {
      "label": "Makan di antara waktu makan utama",
      "options": {
        "1": "Jarang",
        "2": "Kadang-kadang",
        "3": "Biasanya",
        "4": "Selalu"
      }
    },
    "Smoking": {
      "label": "Merokok?",
      "options": {
        "1": "Ya",
        "2": "Tidak"
      }
    },
    "Liquid_Intake_Daily": {
      "label": "Asupan cairan per hari",
      "options": {
        "1": "Kurang dari 1 liter",
        "2": "1-2 liter",
        "3": "Lebih dari 2 liter"
      }
    },
    "Calculation_of_Calorie_Intake": {
      "label": "Menghitung asupan kalori?",
      "options": {
        "1": "Ya",
        "2": "Tidak"
      }
    },
    "Physical_Exercise": {
      "label": "Frekuensi olahraga",
      "options": {
        "1": "Tidak pernah",
        "2": "1-2 hari/minggu",
        "3": "3-4 hari/minggu",
        "4": "5-6 hari/minggu",
        "5": "Lebih dari 6 hari/minggu"
      }
    },
    "Schedule_Dedicated_to_Technology": {
      "label": "Waktu untuk teknologi/gadget per hari",
      "options": {
        "1": "0-2 jam",
        "2": "3-5 jam",
        "3": "Lebih dari 5 jam"
      }
    },
    "Type_of_Transportation_Used": {
      "label": "Moda transportasi utama",
      "options": {
        "1": "Mobil",
        "2": "Sepeda motor",
        "3": "Sepeda",
        "4": "Transportasi umum",
        "5": "Jalan kaki"
      }
    }
  },
  "training": {
    "scenario": "D: + SMOTE + Tuning",
    "use_smote": true,
    "n_features": 14,
    "feature_engineering": false,
    "feature_selection": false,
    "lightgbm_params": {
      "subsample": 0.8,
      "num_leaves": 127,
      "n_estimators": 150,
      "min_child_samples": 10,
      "max_depth": -1,
      "learning_rate": 0.1,
      "colsample_bytree": 0.6
    },
    "mlp_params": {
      "learning_rate_init": 0.0005,
      "hidden_layer_sizes": [
        200,
        100
      ],
      "alpha": 0.001,
      "activation": "tanh"
    },
    "ensemble_weights": {
      "lightgbm": 0.5,
      "mlp": 0.5
    },
    "seed": 42,
    "cv_folds": 5
  },
  "versions": {
    "python": "3.13.16",
    "scikit-learn": "1.6.1",
    "lightgbm": "4.6.0",
    "imbalanced-learn": "0.14.2",
    "pandas": "2.2.3",
    "numpy": "2.4.6",
    "joblib": "1.6.0"
  }
}